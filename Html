<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta
    name="description"
    content="A simple, cozy kilometer and mile converter with instant results."
  >
  <title>Cozy Distance Converter</title>
  <link rel="stylesheet" href="styles.css">
  <script src="script.js" defer></script>
</head>
<body>
  <main class="page-shell">
    <section class="converter-card" aria-labelledby="app-title">
      <header class="card-header">
        <p class="eyebrow">Crisp-air calculations</p>
        <h1 id="app-title">Distance Converter</h1>
        <p class="intro">A little trail math, ready as you type.</p>
      </header>

      <div class="form-group">
        <label for="distance">Distance</label>
        <input
          id="distance"
          name="distance"
          type="number"
          inputmode="decimal"
          step="any"
          placeholder="Enter a number"
          autocomplete="off"
          aria-describedby="input-help"
        >
        <p id="input-help" class="help-text">Decimals are welcome.</p>
      </div>

      <fieldset class="form-group">
        <legend>Convert</legend>

        <div class="direction-options">
          <label class="direction-option">
            <input type="radio" name="direction" value="km-to-mi" checked>
            <span>km → mi</span>
          </label>

          <label class="direction-option">
            <input type="radio" name="direction" value="mi-to-km">
            <span>mi → km</span>
          </label>
        </div>
      </fieldset>

      <section class="result-panel" aria-labelledby="result-heading">
        <h2 id="result-heading">Your conversion</h2>
        <p id="result" class="result-message" aria-live="polite">
          Enter a number to see the conversion.
        </p>
      </section>

      <p class="footnote">
        Measured carefully with 1 mile = 1.609344 kilometers.
      </p>
    </section>
  </main>
</body>
</html>
